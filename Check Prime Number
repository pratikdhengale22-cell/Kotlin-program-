
fun isPrime(n: Int): Boolean {
    if (n < 2) return false

    for (i in 2..n / i) {
        if (n % i == 0) {
            return false
        }
    }

    return true
}

fun main() {
    print("Enter a number: ")
    val n = readLine()!!.toInt()

    if (isPrime(n)) {
        println("$n is a Prime Number")
    } else {
        println("$n is not a Prime Number")
    }
}
