fun main() {
    print("Enter first number: ")
    val a = readLine()!!.toInt()

    print("Enter second number: ")
    val b = readLine()!!.toInt()

    if (a > b) {
        println("$a is greater")
    } else if (b > a) {
        println("$b is greater")
    } else {
        println("Both are equal")
    }
}
